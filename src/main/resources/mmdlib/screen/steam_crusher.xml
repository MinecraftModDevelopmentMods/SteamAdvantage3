<?xml version='1.0' encoding='utf-8'?>
<screen xmlns="https://moddev.zone/mmdlib/screen" title="block.steamadvantage.steam_crusher" block-entity="zone.moddev.mc.SteamAdvantage.machines.SteamMachine">
  <vbox padding="7" spacing="6">
    <hbox spacing="6" align="center">
      <group label="screen.steamadvantage.steam" padding="4">
        <gauge id="steam" orientation="vertical" length="64" value="#getSteamTank" max="#getSteamCapacity" tooltip="screen.steamadvantage.steam_amount" />
      </group>
      <group label="screen.steamadvantage.input" padding="4">
        <slot index="0" />
      </group>
      <progress value="#getProgress" max="#getProgressMax" tooltip-shift="screen.steamadvantage.progress_amount" jei-recipes="mmdlib:crushing" />
      <group label="screen.steamadvantage.output" padding="4">
        <slot index="4" size="large" />
      </group>
    </hbox>
  </vbox>
</screen>