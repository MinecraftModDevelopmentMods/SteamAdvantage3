<?xml version="1.0" encoding="utf-8"?>
<machine xmlns="https://moddev.zone/mmdlib/machine" version="1"
         extends="steamadvantage:steam_base" name="Electric Steam Boiler">
  <appearance preset="model" model="steamadvantage:block/steam_boiler_electric_model"/>
  <storage>
    <fluids id="Fluids">
      <tank id="steam" name="Steam" role="output" capacity="20000" fluid="poweradvantage:steam" color="#C8C8C8"/>
      <tank id="water" name="Water" role="input" capacity="4000" fluid="minecraft:water" color="#3F76E4"/>
    </fluids>
    <energy id="energy" name="Energy" capacity="1600" input-rate="160" output-rate="0" color="#D03030"/>
  </storage>
  <redstone comparator-source="steamadvantage/comparator"/>
  <processor id="boiler" class="zone.moddev.mc.SteamAdvantage.machines.ElectricBoilerProcessor"/>
  <screen xmlns="https://moddev.zone/mmdlib/screen" extends="mmdlib:base_powered_machine"/>
</machine>
