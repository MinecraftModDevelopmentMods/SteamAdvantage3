<?xml version="1.0" encoding="utf-8"?>
<machine xmlns="https://moddev.zone/mmdlib/machine" version="1"
         extends="steamadvantage:steam_base" name="Steam Tank">
  <block no-occlusion="true"/>
  <appearance preset="model" model="steamadvantage:block/steam_tank_model"/>
  <storage>
    <!-- "Fluids" is the key SA3 has always saved its tanks under. -->
    <fluids id="Fluids">
      <tank id="steam" name="Steam" role="storage" capacity="1000000"
            fluid="poweradvantage:steam" color="#C8C8C8"/>
    </fluids>
  </storage>
  <redstone comparator-source="steamadvantage/comparator"/>
  <processor id="tank" class="zone.moddev.mc.SteamAdvantage.machines.SteamTankProcessor"/>
</machine>
