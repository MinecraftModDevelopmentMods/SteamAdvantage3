<?xml version="1.0" encoding="utf-8"?>
<machine xmlns="https://moddev.zone/mmdlib/machine" version="1"
         extends="steamadvantage:steam_base" name="Steam Pump">
  <appearance preset="model" model="steamadvantage:block/steam_pump_model"/>
  <storage>
    <fluids id="Fluids">
      <tank id="steam" name="Steam" role="input" capacity="20000" fluid="poweradvantage:steam" color="#C8C8C8"/>
      <tank id="product" name="Pumped Fluid" role="output" capacity="4000" color="#70A050"/>
    </fluids>
  </storage>
  <redstone comparator-source="steamadvantage/comparator"/>
  <processor id="pump" class="zone.moddev.mc.SteamAdvantage.machines.PumpProcessor"/>
</machine>
